# Porta 8081: SEM login, publicada só em 127.0.0.1 do servidor (administração e diagnóstico local).
server {
    listen 8081;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2g;

    rewrite ^${STUDIO_BASE_PATH}(.*)$ /$1 last;

    location /api/ {
        proxy_pass http://studio-api:8100;
        proxy_set_header X-API-Key "${STUDIO_API_KEY}";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri /index.html;
    }
}
