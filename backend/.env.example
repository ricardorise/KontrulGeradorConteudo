# Banco kontrul-postgres-1 (db sofia) — schema content_studio é criado pelas migrações.
STUDIO_DATABASE_URL=postgresql://sofia:CHANGE_ME@postgres:5432/sofia
# Como falar com o Hermes: via SSH ao servidor (docker exec hermes ...). Vazio = docker local.
STUDIO_HERMES_SSH=rises@10.241.168.46
STUDIO_HERMES_SSH_KEY=/run/ssh/id_ed25519
STUDIO_HERMES_CONTAINER=hermes
STUDIO_AGENT_TIMEOUT_S=600
STUDIO_MAX_CONCURRENT_AGENTS=3
# Opcional: exige X-API-Key nas rotas /api
STUDIO_API_KEY=
STUDIO_CORS_ORIGINS=http://localhost:5173
STUDIO_COMFY_URL=http://rises:8188
# STUDIO_COMFY_WORKFLOW_PATH=/caminho/para/export-api.json  (opcional: usa seu export API no lugar do convertido)
STUDIO_MEDIA_DIR=./data/media
STUDIO_MAX_UPLOAD_MB=1024
# STUDIO_FFMPEG=/caminho/do/ffmpeg   (padrão: ffmpeg no PATH)
