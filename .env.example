# Copie para .env no servidor (não versionar).
STUDIO_DB_PASSWORD=senha-do-usuario-sofia-no-kontrul-postgres-1
STUDIO_HERMES_SSH=rises@10.241.168.46
# Recomendado se a porta ficar exposta na LAN: o nginx injeta a chave, o navegador nunca a vê.
STUDIO_API_KEY=
STUDIO_WEB_BIND=127.0.0.1
STUDIO_WEB_PORT=8795
# ComfyUI (workflow "videos do papotechcast"); de dentro do container use o IP do servidor.
STUDIO_COMFY_URL=http://10.241.168.46:8188
# Acesso pela VPS: o app é servido sob o prefixo do Editor para reaproveitar o cookie de login dele.
STUDIO_BASE_PATH=/kontrul-editor/gerador/
STUDIO_LOGIN_URL=/kontrul-editor/
# STUDIO_AUTH_URL=http://kontrul-editor-api-1:8000/v1/auth/check
